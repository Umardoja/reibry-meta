# Server-only configuration. Leave disabled until a disposable project is approved.
AUTH_ENABLED=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
AUTH_SITE_URL=
# Use a NEW project's publishable key only. Never copy original production values.
# No service-role/secret/legacy JWT keys are accepted. No NEXT_PUBLIC auth variables.
# Server-only and default-off. Enable only after Supadata's account credit ceiling is verified.
SUPADATA_API_KEY=
SUPADATA_ENRICHMENT_ENABLED=false
# Optional 1–12 per-hour guard per server instance; it is not a distributed billing ledger.
SUPADATA_MAX_REQUESTS_PER_USER_HOUR=6
